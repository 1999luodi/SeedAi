{
  "categories": [
    {
      "name": "认证",
      "icon": "🔐",
      "endpoints": [
        {
          "name": "用户登录",
          "method": "POST",
          "endpoint": "/api/auth/login",
          "description": "用户登录获取JWT Token",
          "example": {
            "username_or_email": "admin",
            "password": "123456"
          }
        },
        {
          "name": "后端管理员登录",
          "method": "POST",
          "endpoint": "/backend/login",
          "description": "后端管理系统登录，需要管理员权限",
          "example": {
            "username_or_email": "admin",
            "password": "123456"
          }
        },
        {
          "name": "用户注册",
          "method": "POST",
          "endpoint": "/api/auth/register",
          "description": "注册新用户",
          "example": {
            "username": "newuser",
            "email": "newuser@example.com",
            "password": "SecurePassword123"
          }
        },
        {
          "name": "获取个人资料",
          "method": "GET",
          "endpoint": "/api/users/profile",
          "description": "获取当前用户信息",
          "example": {}
        },
        {
          "name": "修改用户信息",
          "method": "PUT",
          "endpoint": "/api/users/profile",
          "description": "修改当前用户信息",
          "example": {
            "email": "updated@example.com"
          }
        }
      ]
    },
    {
      "name": "用户管理",
      "icon": "👥",
      "endpoints": [
        {
          "name": "获取用户列表",
          "method": "GET",
          "endpoint": "/api/admin/users",
          "description": "获取所有用户列表（管理员）",
          "example": {}
        },
        {
          "name": "切换用户状态",
          "method": "POST",
          "endpoint": "/api/admin/users/{user_id}/toggle-status",
          "description": "启用/禁用用户账户",
          "example": {}
        }
      ]
    },
    {
