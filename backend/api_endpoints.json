{
  "categories": [
    {
      "name": "认证",
      "icon": "🔐",
      "endpoints": [
        {
          "name": "用户登录",
          "method": "POST",
          "endpoint": "/api/auth/login",
          "description": "用户登录获取JWT Token",
          "example": {
            "username_or_email": "admin",
            "password": "123456"
          }
        },
        {
          "name": "后端管理员登录",
          "method": "POST",
          "endpoint": "/backend/login",
          "description": "后端管理系统登录，需要管理员权限",
          "example": {
            "username_or_email": "admin",
            "password": "123456"
          }
        },
        {
          "name": "用户注册",
          "method": "POST",
          "endpoint": "/api/auth/register",
          "description": "注册新用户",
          "example": {
            "username": "newuser",
            "email": "newuser@example.com",
            "password": "SecurePassword123"
          }
        },
        {
          "name": "获取个人资料",
          "method": "GET",
          "endpoint": "/api/users/profile",
          "description": "获取当前用户信息",
          "example": {}
        },
        {
          "name": "修改用户信息",
          "method": "PUT",
          "endpoint": "/api/users/profile",
          "description": "修改当前用户信息",
          "example": {
            "email": "updated@example.com"
          }
        }
      ]
    },
    {
      "name": "用户管理",
      "icon": "👥",
      "endpoints": [
        {
          "name": "获取用户列表",
          "method": "GET",
          "endpoint": "/api/admin/users",
          "description": "获取所有用户列表（管理员）",
          "example": {}
        },
        {
          "name": "切换用户状态",
          "method": "POST",
          "endpoint": "/api/admin/users/{user_id}/toggle-status",
          "description": "启用/禁用用户账户",
          "example": {}
        }
      ]
    },
    {
      "name": "数据集管理",
      "icon": "📊",
      "endpoints": [
        {
          "name": "创建数据集",
          "method": "POST",
          "endpoint": "/api/datasets",
          "description": "创建新的数据集",
          "example": {
            "name": "My Dataset",
            "description": "A sample dataset for testing"
          }
        },
        {
          "name": "获取数据集列表",
          "method": "GET",
          "endpoint": "/api/datasets",
          "description": "获取用户的数据集列表",
          "example": {}
        },
        {
          "name": "获取数据集详情",
          "method": "GET",
          "endpoint": "/api/datasets/{dataset_id}",
          "description": "获取指定数据集的详细信息",
          "example": {}
        },
        {
          "name": "修改数据集介绍",
          "method": "PUT",
          "endpoint": "/api/datasets/{dataset_id}",
          "description": "修改数据集信息",
          "example": {
            "name": "Updated Dataset Name",
            "description": "Updated description"
          }
        },
        {
          "name": "删除数据集",
          "method": "DELETE",
          "endpoint": "/api/datasets/{dataset_id}",
          "description": "删除指定数据集，并清理该数据集下的图片记录、标注文件、类别配置及对应数据库记录",
          "example": {}
        },
        {
          "name": "获取标签类别",
          "method": "GET",
          "endpoint": "/api/datasets/{dataset_id}/label-categories",
          "description": "获取数据集的标签类别列表",
          "example": {}
        },
        {
          "name": "新增标签类别",
          "method": "POST",
          "endpoint": "/api/datasets/{dataset_id}/label-categories",
          "description": "为数据集新增一个标签类别",
          "example": {
            "name": "seed"
          }
        },
        {
          "name": "删除标签类别",
          "method": "DELETE",
          "endpoint": "/api/datasets/{dataset_id}/label-categories",
          "description": "删除数据集中的指定标签类别",
          "example": {
            "name": "seed"
          }
        }
      ]
    },
    {
      "name": "图片管理",
      "icon": "🖼️",
      "endpoints": [
        {
          "name": "上传图片到数据集",
          "method": "POST",
          "endpoint": "/api/datasets/{dataset_id}/upload",
          "description": "上传图片到指定数据集；支持可选同名 annotation(JSON) 文件。annotation 会写入 datasets/<user>/<dataset>_<id>/annotations，并回写 images.annotations_path。前端需保证图片与JSON按文件名一一唯一对应，若同名出现>=3个则整组禁止上传。",
          "example": {
            "multipart/form-data": {
              "file": "seed_001.jpg",
              "annotation": "seed_001.json"
            }
          }
        },
        {
          "name": "获取图片信息",
          "method": "GET",
          "endpoint": "/api/images/{image_id}",
          "description": "获取指定图片的详细信息",
          "example": {}
        },
        {
          "name": "获取图片标注",
          "method": "GET",
          "endpoint": "/api/images/{image_id}/annotations",
          "description": "读取图片对应的标注文件（COCO），返回标注内容和文件路径",
          "example": {}
        },
        {
          "name": "保存标签文件",
          "method": "POST",
          "endpoint": "/api/images/{image_id}/label-file",
          "description": "前端完成标注的新增/修改/删除后，仅在数据有变更时提交最终结果，导出为COCO文件并覆盖保存，同时将文件路径写入images.annotations_path",
          "example": {
            "annotations": [
              {
                "label": "seed",
                "x_min": 0.1,
                "y_min": 0.1,
                "x_max": 0.5,
                "y_max": 0.5,
                "confidence": 1
              }
            ],
            "classes": [
              "seed",
              "root"
            ]
          }
        },
        {
          "name": "执行AI检测",
          "method": "POST",
          "endpoint": "/api/images/{image_id}/detect",
          "description": "调用后端AI推理编排接口。后端会把图片转发给ai_worker模型服务，返回标准化检测框（包含类别与置信度）",
          "example": {
            "conf_threshold": 0.8,
            "model_name": "yolov5s"
          }
        }
      ]
    },
    {
      "name": "系统",
      "icon": "⚙️",
      "endpoints": [
        {
          "name": "获取API端点定义",
          "method": "GET",
          "endpoint": "/api/endpoints",
          "description": "获取所有API端点的定义",
          "example": {}
        },
        {
          "name": "统计信息",
          "method": "GET",
          "endpoint": "/api/stats",
          "description": "获取首页统计信息",
          "example": {}
        }
      ]
    },
    {
      "name": "模型管理",
      "icon": "🧠",
      "endpoints": [
        {
          "name": "获取模型列表",
          "method": "GET",
          "endpoint": "/api/models",
          "description": "获取模型配置列表（管理员）",
          "example": {}
        },
        {
          "name": "创建模型配置",
          "method": "POST",
          "endpoint": "/api/models",
          "description": "创建模型配置（名称、路径、类别列表）",
          "example": {
            "model_name": "seed-yolov5",
            "model_path": "/workspace/online/models/service/soybean/yolov5-soybean.onnx",
            "class_list": [
              "腐烂",
              "发芽",
              "未发芽"
            ],
            "is_active": true
          }
        },
        {
          "name": "更新模型配置",
          "method": "PUT",
          "endpoint": "/api/models/{model_id}",
          "description": "更新模型名称、路径、类别列表、启用状态（管理员）",
          "example": {
            "model_path": "/workspace/online/models/service/soybean/yolov5-soybean.onnx",
            "class_list": [
              "腐烂",
              "发芽",
              "未发芽"
            ]
          }
        },
        {
          "name": "启用指定模型",
          "method": "POST",
          "endpoint": "/api/models/{model_id}/activate",
          "description": "将指定模型设为当前推理默认模型（管理员）",
          "example": {}
        }
      ]
    }
  ]
}