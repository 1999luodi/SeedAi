          "description": "获取指定数据集的详细信息",
          "example": {}
        },
        {
          "name": "修改数据集介绍",
          "method": "PUT",
          "endpoint": "/api/datasets/{dataset_id}",
          "description": "修改数据集信息",
          "example": {
            "name": "Updated Dataset Name",
            "description": "Updated description"
          }
        },
        {
          "name": "删除数据集",
          "method": "DELETE",
