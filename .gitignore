# 忽略MySQL数据目录
/mysql_data/data/

# 可选：忽略特定的MySQL socket文件（如果存在）
*.sock

# 可选：忽略系统临时文件
.DS_Store
Thumbs.db

# 运行时上传与数据集存储目录（Docker bind mounts）
/data/uploads/
/data/datasets/

# Python 缓存
__pycache__/
*.py[cod]
*$py.class
*.so

# 虚拟环境
venv/
env/
.venv/

# IDE 文件
.vscode/
.idea/
*.swp
*.swo
/process-data/data/

*.onnx

# 环境变量与敏感配置
.env
.env.*
!.env.example
!.env.template

# 测试与运行缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# 运行日志与临时文件
*.log
*.tmp
*.temp
*.pid

# Jupyter/笔记本缓存
.ipynb_checkpoints/

# 前端依赖与构建产物
node_modules/
dist/
build/

# 模型权重与大文件（避免误提交）
*.pt
*.pth
*.ckpt
*.safetensors
*.h5
*.pb
*.tflite

# 项目运行时目录
/backend/uploads/
/pytorch_model/uploads/
/pytorch_model/online/uploads/


